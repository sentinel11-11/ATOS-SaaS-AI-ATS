# Local development: source scripts/dev-env.sh (no TCP listener on PostgreSQL).
# Production: set these securely on the deployment host; never commit .env.
ATS_DATABASE_URL=postgresql+psycopg://ats:CHANGE_ME@postgres:5432/ats
ATS_DEPLOYMENT=preprod
ATS_INSTANCE_NAME=ats-preprod
ATS_PUBLIC_ORIGIN=https://ats.example.invalid
ATS_SECURE_COOKIES=true
ATS_LIVE_CALLS_ENABLED=false
ATS_TELEPHONY_TENANT_ID=
# Comma-separated, consented test numbers in +E.164. Required for live calls.
ATS_TEST_DESTINATIONS=
ATS_AMI_HOST=127.0.0.1
ATS_AMI_PORT=5039
ATS_AMI_TLS=true
ATS_AMI_USER=ats-beta
ATS_AMI_SECRET=
ATS_AMI_CALLER_ID=
ATS_MEGAFON_URL=
ATS_MEGAFON_USER=
ATS_MEGAFON_API_KEY=
ATS_MEGAFON_CRM_TOKEN=
ATS_CRM_ENABLED=false
ATS_AMO_TENANT_ID=
ATS_AMO_URL=
# Beta uses an amoCRM private-integration access token; rotate securely. No automatic OAuth refresh.
ATS_AMOCRM_TOKEN=
