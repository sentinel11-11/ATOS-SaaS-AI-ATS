# Multicom SIP / Asterisk settings for the existing deployment environment.
# Merge the reviewed fields with /etc/ats-beta/ats.env on the VPS.
ATS_DEPLOYMENT=preprod
ATS_LIVE_CALLS_ENABLED=false
ATS_TELEPHONY_TENANT_ID=
ATS_TEST_DESTINATIONS=

# Local Asterisk 20.6.0 endpoint recorded in the project specification.
ATS_AMI_HOST=127.0.0.1
ATS_AMI_PORT=5038
ATS_AMI_TLS=false
ATS_AMI_USER=ats-beta
ATS_AMI_SECRET=
ATS_AMI_TECH=PJSIP
ATS_AMI_TRUNK=mcm
ATS_AMI_CLI_ENDPOINT_PREFIX=mcm-cli-
# Select the caller from the explicitly verified and enabled Multicom pool.
ATS_AMI_CALLER_ID=
ATS_AMI_CONTEXT=ats-beta
ATS_AMI_ANSWER_CONTEXT=ats-beta-answer

# The first message-mode test plays hello-world through the existing dialplan.
ATS_MEDIA_ENABLED=false
ATS_INBOUND_ENABLED=false
