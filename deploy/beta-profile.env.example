# Non-secret profile derived from the user's working legacy settings.
# Supply tenant UUIDs, verified CLI and real secrets securely on the PBX/deployment host.
ATS_DEPLOYMENT=preprod
ATS_INSTANCE_NAME=ats-preprod
ATS_LIVE_CALLS_ENABLED=false
ATS_TELEPHONY_TENANT_ID=
ATS_TEST_DESTINATIONS=
# 127.0.0.1 only if ATS runs on the SAME host as the existing Asterisk.
# From a cloud machine this must be a secured private route/tunnel to that PBX.
ATS_AMI_HOST=127.0.0.1
# Preprod must get a separate AMI account/port or a separate PBX before live UAT.
ATS_AMI_PORT=5039
ATS_AMI_TLS=false
ATS_AMI_USER=ats-preprod
ATS_AMI_SECRET=
# An operator-authorized number, d10, e.g. ten digits (no fabricated Caller ID).
ATS_AMI_CALLER_ID=
ATS_MEGAFON_URL=https://vats326349.megapbx.ru
ATS_MEGAFON_USER=admin
ATS_MEGAFON_API_KEY=
ATS_MEGAFON_CRM_TOKEN=
ATS_CRM_ENABLED=false
ATS_AMO_TENANT_ID=
ATS_AMO_URL=https://axiomcore.amocrm.ru
ATS_AMOCRM_TOKEN=

# Local media and inbound observation are independent, disabled gates.
ATS_INBOUND_ENABLED=false
ATS_INBOUND_CONTEXTS=from-mcm,ats-in
ATS_MEDIA_ENABLED=false
ATS_MEDIA_DIR=/var/lib/ats-beta-media
ATS_ASTERISK_RECORDINGS_DIR=/var/spool/asterisk/monitor/ats-beta
ATS_RECORDINGS_DIR=/var/lib/ats-beta/recordings
