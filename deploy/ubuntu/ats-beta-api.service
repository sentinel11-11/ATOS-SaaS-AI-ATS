[Unit]
Description=ATS beta API (loopback, separate from legacy ATS)
After=network.target postgresql.service
Requires=postgresql.service
StartLimitIntervalSec=60
StartLimitBurst=5

[Service]
Type=simple
User=ats-beta
Group=ats-beta
WorkingDirectory=/opt/ats-beta
EnvironmentFile=/etc/ats-beta/ats.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/ats-beta/.venv/bin/python -m uvicorn ats.api:app --host 127.0.0.1 --port 9130 --no-access-log
Restart=on-failure
RestartSec=3
TimeoutStopSec=20
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/ats-beta
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
